# Ignore image files under dataset/ and 100x FOV/ (recursively)
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.tif
dataset/**/*.tiff
dataset/**/*.bmp
dataset/**/*.webp

100x FOV/**/*.jpg
100x FOV/**/*.jpeg
100x FOV/**/*.png
100x FOV/**/*.tif
100x FOV/**/*.tiff

# (Optional) other big artifacts
dataset/**/*.npy
dataset/**/*.pt
dataset/**/*.pth
100x FOV/**/*.npy
100x FOV/**/*.pt
100x FOV/**/*.pth

# Surplus crops produced by balance_slides.py
dataset_unused/

# Per-run LOPO outputs (predictions, checkpoints, fold configs).
# Transferred separately, not committed to git.
outputs/lopo/

# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/

# Claude Code local state (worktrees, session data)
.claude/
